# ─────────────────────────────────────────────────────────────
# Aladdin Distribuidora Premium — variáveis de ambiente
# Configure na Vercel: Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# OBRIGATÓRIA — PostgreSQL (Neon). Formato exato:
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
# Exemplo Neon:
# DATABASE_URL="postgresql://usuario:senha@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# OPCIONAL — Analytics (deixe vazio para desabilitar)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""

# OPCIONAL — URL pública do site (SEO canonical/sitemap). A Vercel define VERCEL_URL automaticamente.
NEXT_PUBLIC_SITE_URL="https://seu-projeto.vercel.app"

# OPCIONAL — segredo das sessões do painel admin (troque em produção)
ADMIN_SESSION_SECRET="troque-por-uma-string-aleatoria-longa"

# OPCIONAL — senha inicial do admin no seed (usuário: admin)
ADMIN_PASSWORD="aladdin2026"
